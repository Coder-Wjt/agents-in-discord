# Minimal project config.
# Keep platform/runtime settings here.
# CLI login/auth is managed by your local `codex` / `claude` / `agy` / `zcode` / `pi` / `omp`, not by this file.
# Everything else falls back to in-code defaults; add extra keys only when you really need an override.

# ============================================================
# Shared
# ============================================================

# Restrict bot access. Leave empty to allow all.
ALLOWED_CHANNEL_IDS=
ALLOWED_GUILD_IDS=
ALLOWED_USER_IDS=
# MENTION_ONLY_CHANNEL_IDS=

# Legacy fallback root for auto-created thread workspaces.
WORKSPACE_ROOT=./workspaces

# Optional shared default workspace for all providers.
# DEFAULT_WORKSPACE_DIR=~/GitHub

# Child thread workspace mode:
# - inherit: reuse the parent channel's explicit workspace
# - separate: use the child thread's own default/fallback workspace instead
# CHILD_THREAD_WORKSPACE_MODE=inherit

# Default UI language for bot hints: zh | en
DEFAULT_UI_LANGUAGE=zh

# Extra info sent to the runner with each platform prompt.
# EXTRA_INFO_ENABLED=true
# EXTRA_INFO_TEXT=[Via agents-in-discord; conversation={conversation}; parent={parent}]

# Stream model reasoning summaries into the live progress card. Off by default:
# reasoning text is a summary, not a full chain of thought, and it competes with
# the agent's own progress narration for space on the card.
#
# Requires the CLI to emit reasoning events too. For Codex that means setting
# `model_reasoning_summary = "detailed"` in ~/.codex/config.toml. Verified with
# codex-cli 0.144.0: gpt-5.4 emits `reasoning` items once that is set, but the
# gpt-5.6 models (sol/terra/luna) emit none, because their entries in
# ~/.codex/models_cache.json omit the `supports_reasoning_summaries` field that
# the CLI requires to load the cache at all.
# SHOW_REASONING=false

# agents-in-discord project update checks:
# - notify is the default: check remote updates and show prompts without changing files
# - auto only upgrades when the git worktree is clean and the remote update is a fast-forward
# AGENTS_IN_DISCORD_UPGRADE_MODE=notify
# AGENTS_IN_DISCORD_UPGRADE_ADMIN_USER_IDS=
# AGENTS_IN_DISCORD_UPGRADE_NOTIFY_CHANNEL_IDS=
# AGENTS_IN_DISCORD_UPGRADE_CHECK_INTERVAL_MS=21600000
# AGENTS_IN_DISCORD_UPGRADE_STATUS_CACHE_MS=600000
# AGENTS_IN_DISCORD_UPGRADE_VERIFY_COMMAND=npm run test:progress
# AGENTS_IN_DISCORD_UPGRADE_RESTART_TARGET=all

# Force mention-only in selected guilds. Comma-separated guild IDs.
# MENTION_ONLY_ENABLED_GUILD_IDS=
# MENTION_ONLY_DISABLED_GUILD_IDS=

# Shared slash prefix (used mainly in shared mode).
# Dedicated bots default to cx (codex) / cc (claude) / ag (antigravity) / zc (zcode) / pi / omp unless overridden below.
# SLASH_PREFIX=cx

# Optional proxy. Runtime auto-repair fills equivalent upper/lowercase keys in memory only;
# temporary smoke-test proxy values are never written back to this file automatically.
HTTP_PROXY=
HTTPS_PROXY=
SOCKS_PROXY=
ALL_PROXY=
INSECURE_TLS=0

# ============================================================
# Platform selection
# ============================================================

# Discord remains the default. `npm run start:lark` sets BOT_PLATFORM=lark.
# BOT_PLATFORM=discord
# Stable instance id used to isolate session files and process/workspace locks.
# BOT_INSTANCE_ID=default

# Feishu/Lark integration (Node.js 18+). Enable im.message.receive_v1,
# application.bot.menu_v6 (when using native bot menus), and card.action.trigger.
# auto: use SDK WebSocket when App ID/Secret are set, otherwise reuse the persistent lark-cli login.
# webhook: run the SDK dispatcher behind HTTP with token checks and optional signature/decryption when an encrypt key is set.
# LARK_TRANSPORT=auto
# CLI transport (recommended for local use after `lark-cli config init` / `lark-cli auth login`).
# LARK_CLI_BIN=lark-cli
# LARK_CLI_PROFILE=
# Direct SDK transport (recommended for servers with an external secret store).
# LARK_APP_ID=cli_xxx
# LARK_APP_SECRET=
# Mainland China: feishu; international: lark
# LARK_DOMAIN=feishu
# Webhook transport. Keep the default loopback host behind a TLS reverse proxy,
# or set 0.0.0.0 explicitly when the container/network boundary is trusted.
# LARK_WEBHOOK_VERIFICATION_TOKEN=
# LARK_WEBHOOK_ENCRYPT_KEY=
# LARK_WEBHOOK_HOST=127.0.0.1
# LARK_WEBHOOK_PORT=3000
# LARK_WEBHOOK_PATH=/lark/events
# LARK_WEBHOOK_HEALTH_PATH=/healthz
# Optional public callback URL used only by smoke:lark-webhook-live.
# LARK_WEBHOOK_PUBLIC_URL=https://bot.example.com/lark/events
# LARK_WEBHOOK_MAX_BODY_BYTES=1048576
# Bound slow or idle HTTP clients before they can occupy listener sockets indefinitely.
# LARK_WEBHOOK_HEADERS_TIMEOUT_MS=10000
# LARK_WEBHOOK_REQUEST_TIMEOUT_MS=15000
# LARK_WEBHOOK_KEEP_ALIVE_TIMEOUT_MS=5000
# Restrict Lark access. Leave empty to allow all.
# Credential-verified deployment readiness requires at least one Lark allowlist.
# LARK_ALLOWED_CHAT_IDS=
# LARK_ALLOWED_TENANT_IDS=
# LARK_ALLOWED_USER_IDS=
# LARK_MENTION_ONLY_CHAT_IDS=
# LARK_HANDSHAKE_TIMEOUT_MS=30000
# LARK_STALE_MESSAGE_WINDOW_MS=300000
# Duplicate message/action/menu event retention and in-memory bound.
# LARK_EVENT_DEDUP_WINDOW_MS=43200000
# LARK_EVENT_DEDUP_MAX_ENTRIES=5000
# LARK_TEXT_CHUNK_LIMIT=4000
# LARK_SEND_MAX_ATTEMPTS=3
# LARK_SEND_RETRY_BASE_DELAY_MS=500

# ============================================================
# WeChat entry (optional, independent from Discord)
# Start with: npm run start:wechat
# ============================================================

# Additional allowed iLink user IDs. The QR-login account is allowed by default.
# WECHAT_ALLOWED_USER_IDS=
# WECHAT_ALLOW_LOGIN_USER=true

# Restrict every /dir and /resume target to these roots.
# Defaults to WORKSPACE_ROOT plus WECHAT_DEFAULT_WORKSPACE_DIR.
# WECHAT_WORKSPACE_ROOTS=~/GitHub,~/Lark_Project
# WECHAT_DEFAULT_WORKSPACE_DIR=~/GitHub

# long = Codex app-server; normal = codex exec --json
# WECHAT_CODEX_RUNTIME_MODE=long
# WECHAT_CODEX_TIMEOUT_MS=0

# Keep dangerous mode unavailable unless explicitly opted in.
# WECHAT_ALLOW_DANGEROUS=false

# Optional WeChat-only proxy. Falls back to HTTPS_PROXY and related standard keys.
# WECHAT_HTTPS_PROXY=http://127.0.0.1:7890

# ============================================================
# Shared mode (single bot, optional)
# ============================================================

# DISCORD_TOKEN=
# DEFAULT_PROVIDER=codex

